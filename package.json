{
  "name": "local-md-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/agent/index.ts",
    "dev:agent": "tsx src/agent/index.ts",
    "dev:server": "tsx src/server/index.ts",
    "build": "tsc",
    "start": "node dist/agent/index.js",
    "start:agent": "node dist/agent/index.js",
    "start:server": "node dist/server/index.js",
    "start:server:docker": "node dist/server/index.js --dir /data/md-pdf/files --port 50001",
    "bundle": "npm run bundle:agent",
    "bundle:agent": "esbuild src/agent/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=build/agent.cjs",
    "bundle:server": "esbuild src/server/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=build/server.cjs",
    "package:win": "npm run package:agent",
    "copy:views": "node -e \"require('fs').cpSync('src/server/views', 'release/views', { recursive: true })\"",
    "package:agent": "npm run bundle:agent && pkg build/agent.cjs --targets node20-win-x64 --output release/md-pdf-agent.exe && npm run copy:views",
    "package:server": "npm run bundle:server && pkg build/server.cjs --targets node20-win-x64 --output release/md-pdf-server.exe && npm run copy:views"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "express": "^5.2.1",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@yao-pkg/pkg": "^6.19.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
